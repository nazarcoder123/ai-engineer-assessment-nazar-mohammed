# ==============================================================================
# Environment Configuration
# Copy this file to .env and populate your personal API keys.
# ==============================================================================

# 1. Superhero API
# Sign in with GitHub at https://superheroapi.com to get your free access token.
SUPERHERO_API_TOKEN=your_superhero_api_token_here

# 2. Hosted LLM Provider Selection ("groq" or "gemini")
# Default: "groq" if GROQ_API_KEY is provided, or "gemini" if GEMINI_API_KEY is provided.
LLM_PROVIDER=groq

# 3. Groq API Configuration (Fast & Free tier available at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile 

# 4. Google Gemini Configuration (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 5. Dataset Configuration
DATASET_DIR=data/mythology_and_legends

# 6. Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
